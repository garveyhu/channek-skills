// 频道卡 channel.json 的 `config` 段模板 —— 频道参数的唯一位置。
//
// 它是什么：你在 app 的「设置 › 本频道 › 参数」里看到的每一个控件，都是一条字段声明出来的。
// 它同时是**喂给 AI 的频道参数表**（渲进 AGENTS.md 的「频道配置」节）。
// 一处声明，三处生效：设置页 UI · AGENTS.md · 各步 skill / 脚本按完整键取值。
//
// 段有两种：
//   作者段 { id, name, group?, hint?, fields }   字段定义和值都写在卡里（频道定位、声场、质检阈值……）
//   插件段 { id, plugin, values }                卡里只存值；字段定义在那个插件清单的 channelConfig 里
//
// 键名：字段里写**段内短键**（`pace`），对外的**完整键 = 段 id + "." + 短键**（`voice.pace`）。
// AGENTS.md、`channek card <完整键>`、插件读值、问卷，统一用完整键。完整键全卡唯一，撞了校验报错。
//
// 铁律：config 只装「一眼一个控件」的扁平项。结构体（色板、音色档、平台矩阵、封面套件）
// 归文件——用 `fileRef` 指过去，别把 JSON 塞进 value。

{
  "config": {
    "sections": [
      {
        // id：卡内唯一、稳定，是完整键的前缀。它是保存寻址 / AGENTS.md 分组 / 体检引用的坐标，
        //     定了就别改（改 = 用户设过的值找不到家、读它的脚本全部取空）。
        "id": "sound",
        "name": "声场",
        "hint": "动效音线锁的机器值，人读判据在锁文档",

        // group 只有三个值，**内核定名、卡只选归哪一组**：
        //   style    这张卡的脸，做片子时会回来动的
        //   rules    频道纪律（锁 / 质检闸 / 发布口径），定下就别常动
        //   advanced 少碰的机器参数
        // 缺省 style。不许自己发明组名——每张卡发明一套，装两张卡导航就是乱的。
        "group": "style",

        "fields": [
          // ── 八种字段类型，一样来一条 ──────────────────────────────

          // ① text：短文本 / 长文本
          {
            "key": "vibe",                           // 段内短键；完整键是 sound.vibe
            "name": "声场气质",                       // 显示名中文直写，无 i18n 层
            "type": "text",
            "value": "暖而不铃：转场用纸感 / 气流质地，落定用软厚音",
            "multiline": true,
            "hint": "生成音效时整句进 prompt",
            "placeholder": "一句话说清这个频道听起来是什么感觉",
            "suggestions": ["暖而不铃", "冷峻克制"]
          },

          // ①b text + valueFrom：长文本外置到频道里的文件（与 value 互斥，只有作者段能用）
          //     超过三五行的说明就该外置——写在 JSON 里既难改也难 diff。
          {
            "key": "avoidNotes",
            "name": "忌用音色说明",
            "type": "text",
            "valueFrom": "brand/locks/忌用音色.md"     // 频道根内相对路径
          },

          // ② number：带单位与范围的数值
          {
            "key": "bedFloorDb",
            "name": "底床地板（dB）",
            "type": "number",
            "value": -28,
            "min": -60,
            "max": 0,
            "step": 1,
            "unit": "dB",
            "required": true                        // 不填就不能用；设置页「N 未填」只数它
          },

          // ③ boolean
          {
            "key": "bgmEnabled",
            "name": "背景乐",
            "type": "boolean",
            "value": true
          },

          // ④ select：给定选项（机器存英文枚举、界面显示中文）
          {
            "key": "introSource",
            "name": "进场音来源",
            "type": "select",
            "value": "fixed",
            "options": [
              { "value": "fixed", "label": "固定文件" },
              { "value": "generated", "label": "每次生成" }
            ],
            "allowUnset": false
          },

          // ⑤ color：只收 hex（#rgb / #rrggbb / #rrggbbaa）
          {
            "key": "waveformColor",
            "name": "波形色",
            "type": "color",
            "value": "#16C79A"
          },

          // ⑥ fileRef：指向频道里的一个文件或文件夹（结构体配置、素材目录都走这条路；路径相对频道根）
          {
            "key": "introFile",
            "name": "进场音文件",
            "type": "fileRef",
            "value": "brand/audio/进场/进场.wav",
            "accept": [".wav", ".mp3"]
          },

          // ⑦ directory：本机目录。**值永不入卡**（落本机的 `.channek/`，那里是这台机器对这个频道的状态）。
          //    写了 value 会被 schema 直接拒——这是可移植性红线，不是风格建议。
          {
            "key": "exportDir",
            "name": "成片导出目录",
            "type": "directory",
            "hint": "每台机器自己配，不随卡走"
          },

          // ⑧ list：字符串列表（情绪词、忌用词、平台账号这类）。别再写逗号分隔的 text 让消费方自己拆
          {
            "key": "sfxAvoid",
            "name": "忌用音色",
            "type": "list",
            "value": ["phone ring", "service desk bell", "marimba"],
            "hint": "每项翻成 no <x> 进生成 prompt",
            "suggestions": ["music box", "shrill metallic"]
          },

          // ── brief：AGENTS.md 渲染开关（缺省 true）─────────────────
          // 标 false = 这项只进设置页，不喂给 AI。
          // 用在「AI 不需要知道、知道了反而是噪音」的项上。
          {
            "key": "sfxSeed",
            "name": "音效生成种子",
            "type": "number",
            "value": 9,
            "brief": false
          }
        ]
      },

      // ── ask：用这张卡开频道时要问收卡人的题 ─────────────────────
      // 「这是谁的频道」那一类值挂 ask：导出时作者的值撤下、改作示例（题里已有 example 就不覆盖）；
      // 收卡人开频道时被问到，不答就留空——而不是顶着作者的人设开工。
      // 惯例放在 id 为 profile 的作者段里，用 text 字段（回答按文本写回）。
      {
        "id": "profile",
        "name": "频道定位",
        "fields": [
          { "key": "niche", "name": "赛道", "type": "text", "value": "<你的赛道>" },
          { "key": "persona", "name": "人设", "type": "text", "value": "<你的人设>",
            "ask": { "example": "带你看透技术泡沫的深度拆解者" } },
          { "key": "slogan", "name": "口号", "type": "text", "value": "<你的口号>", "ask": {} }
        ]
      },

      // ── 插件段：只存值 ──────────────────────────────────────────
      // 字段名、类型、选项、默认值只在插件清单的 channelConfig 里有一份，卡里不抄（抄了必然漂）。
      // id 必须是插件声明过的段 id；值按插件声明校验，声明之外的键报警告；没写的键按插件默认值补。
      // 插件没装时这一段按值只读显示，照常进 AGENTS.md。下面的段名与字段名对应一个出片插件的声明。
      { "id": "visual", "plugin": "acme.production",
        "values": { "imagePrompt": "flat illustration, <你的画风关键词>", "seed": 9,
                    "guide": "brand/locks/画风锁.md" } },
      { "id": "freeze", "plugin": "acme.production",
        "values": { "visualTokens": true, "voice": true, "visualStyle": true } }
    ]
  }
}

// ══════════════════════════════════════════════════════════════════
// 内核不按名字读任何参数
// ══════════════════════════════════════════════════════════════════
//
// 没有「起对名字内核就认」的特殊键。一个参数谁在读，只有两种答案：
//   - 插件段：声明它的那个插件读（出图带画风锁、配音读音色档、发布读账号与横幅……）；
//   - 作者段：你自己的 skill 和脚本按完整键读（`channek card sound.bedFloorDb`）。
// 两种都会渲进 AGENTS.md 的「频道配置」节。所以加一个参数前先问一句：**谁读它？**
// 答不上来，它就只是一行展示。
//
// 什么进 config、什么进 pluginSettings：
//   config          频道的事实与规范（画幅、音色、字幕规范、发布账号）——agent、脚本、多个插件都要知道，进 AGENTS.md
//   pluginSettings  某个插件内部的调参（采样步数、CFG）——只有那一个插件关心，不进 AGENTS.md
