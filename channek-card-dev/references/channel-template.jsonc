// 可抄的完整示例频道卡：口播快剪频道（6 步流水线 · 无分镜 / 无素材生成 / 无封面）
// 抄的时候：改 name 与 card.id，删掉用不上的段——必填只有 4 个字段（schema / formatVersion / name / card.id）；
// 但**某段一旦写了，段内必填就要写全**（清单见 references/generated/card-schema.md）。
// 顶层只认 18 个键，多写一个（哪怕是空段）整张卡就读不通。
// 顶层 id / slug（频道在这台机器上的身份）不用写：app 首次打开时生成并写回，导出卡包时剥掉。
// 写完跑 `channek check <频道目录>`，它用的是 app 读卡时同一份判据，还会按插件清单校验插件段的值。
// 频道目录形态（目录名你自己定，这里是推荐的「菜谱 / 菜」两半）：
//   acme.talkfast/
//   ├── channel.json            ← 本文件（频道卡，只能叫这个名、只能放频道根）
//   ├── AGENTS.md               ← 给 AI 的说明：托管块由 app 按卡生成，下方手写区写宪章与补充约定
//   ├── sop/                    ← 怎么做（菜谱）：随卡分享
//   │   ├── README.md           ← 工作流说明（agent.guide）
//   │   ├── skills/             ← 给 agent 的操作手册（agent.skills，会挂到 .claude/skills/）
//   │   ├── prompts/            ← 提示词（agent.kickoff / agent.prompts）
//   │   ├── kit/scripts/        ← 频道自带的脚本（agent.scripts）
//   │   └── lessons/            ← 质检教训（标了 recipe 的区，随卡走）
//   ├── brand/
//   │   ├── icon.png            ← meta.icon 引用
//   │   ├── tokens.json         ← 设计 token（config 里 brand.tokens 指过来）
//   │   └── voices.json         ← 音色档（config 里 voice.profiles 指过来）
//   ├── STOREFRONT.md           ← 上架长文（要上架才需要）
//   └── work/                   ← 做出来的东西（菜）：分享时不带
//       ├── inbox/              ← 选题
//       ├── runs/<日期-slug>/   ← 每一期
//       └── review/             ← 复盘
{
  "schema": "channek.channel",
  "formatVersion": 2,
  "name": "口播快剪",
  // 卡自己的身份：<发布者>.<名字>。血缘、市场、「从原卡更新」都认它
  "card": { "id": "acme.talkfast", "version": "1.0.0" },

  "meta": {
    "author": "acme",
    "license": "CC-BY-4.0",
    "description": "口播快剪频道模板：6 步流水线 + 暖纸视觉",
    "icon": "brand/icon.png",
    // 自由标签，频道中心按它筛选（横竖屏、媒介都写在这里）
    "tags": ["视频", "竖屏", "口播"]
  },

  "layout": {
    // 内容放哪全由你定。contentDir 与 sections 是「做出来的东西」，分享时不带——
    // 标了 recipe 的区除外（它是菜谱，比如质检教训）
    "contentDir": "work/runs",
    "entryDirName": "{date}-{slug}",
    "sections": [
      { "id": "topics", "path": "work/inbox" },
      { "id": "review", "path": "work/review" },
      { "id": "qc", "path": "sop/lessons", "recipe": true }
    ],
    "artifacts": {
      "acme.script":      "script.md",
      "acme.voiceTrack":  "voice/track.wav",
      "acme.captionCues": "captions/cues.json",
      "acme.master":      "master/final.mp4",
      "acme.delivery":    "deliver/"
    },
    "detect": { "anyOf": ["work/runs"] }
  },

  // 流程只写 steps：数组序就是真实顺序。卡里没写步，这个频道就没有步
  "pipeline": {
    "steps": [
      { "key": "topic",   "step": "acme.topic" },
      { "key": "script",  "step": "acme.script" },
      { "key": "voice",   "step": "acme.voice" },
      { "key": "caption", "step": "acme.caption" },
      { "key": "edit",    "step": "channek.edit" },
      { "key": "publish", "step": "acme.publish" }
    ]
  },

  "presentation": {
    "sections": [{ "id": "homes" }, { "id": "content" }],
    "defaultSection": "homes"
  },

  // 给 AI 的入口：全部写进 AGENTS.md 托管块，skill 挂到 .claude/skills/
  "agent": {
    "guide": "sop/README.md",
    "skills": "sop/skills",
    "scripts": "sop/kit/scripts",
    "kickoff": "sop/prompts/开工.md",
    // 键是步骤找提示词用的名字（步声明的 promptKey），同时当 AGENTS.md 里的标签
    "prompts": { "script": "sop/prompts/script.md" },
    // 键是给人看的名字，原样当 AGENTS.md 里的标签
    "docs": { "口播规范": "sop/口播规范.md" }
  },

  // 频道参数的唯一位置。完整键 = 段 id + "." + 字段键（profile.persona、captions.maxLines）
  "config": {
    "sections": [
      // ── 作者段：字段定义和值都写在卡里 ──
      {
        "id": "profile",
        "name": "频道定位",
        "fields": [
          { "key": "niche", "name": "赛道", "type": "text",
            "value": "口播观点频道：单人出镜 / 快节奏剪辑 / 周更" },
          { "key": "audience", "name": "受众", "type": "text",
            "value": "对效率工具感兴趣的中文观众" },
          // 带 ask 的字段 = 用这张卡开频道时要问的题。导出时作者的值会撤下、改作示例
          { "key": "persona", "name": "人设", "type": "text",
            "value": "讲清楚一个效率工具只要三分钟的博主",
            "ask": { "example": "三分钟讲透一个效率工具的博主" } }
        ]
      },
      {
        "id": "brand",
        "name": "品牌",
        "fields": [
          // 结构化的大块数据放文件，卡里只记路径
          { "key": "tokens", "name": "设计 token", "type": "fileRef", "value": "brand/tokens.json" }
        ]
      },
      {
        "id": "quality",
        "name": "质检",
        "group": "rules",
        "fields": [
          { "key": "scriptMaxSec", "name": "口播稿时长上限（秒）", "type": "number", "value": 180,
            "hint": "超了就拆成两期，不靠加速念完" }
        ]
      },

      // ── 插件段：卡里只存值，字段名、类型、选项、默认值在插件清单的 channelConfig 里 ──
      // 段 id 必须是那个插件声明过的段 id；没写的键按插件声明的默认值补
      { "id": "format", "plugin": "acme.production",
        "values": { "orientation": "portrait", "persona": "real", "captions": "sentence" } },
      { "id": "captions", "plugin": "acme.production",
        "values": { "highlight": true, "maxLines": 2, "wordsPerLine": 14, "stroke": "soft" } },
      { "id": "voice", "plugin": "acme.production",
        "values": { "default": "host", "profiles": "brand/voices.json", "pace": 4.5 } },
      { "id": "publish", "plugin": "acme.publish-platforms",
        "values": { "accounts": ["bilibili", "douyin"] } }
    ]
  },

  "requires": {
    "app": ">=0.9.0",
    "providers": [
      { "capability": "channek.tts",
        "prefer": ["acme.voxcpm-local"],
        "plugins": ["acme.voice-lab"],
        "reason": "频道音色按这家调过" },
      { "capability": "channek.asr", "prefer": ["acme.whisper-local"] }
    ],
    // 全局插件：按 id 要，收卡人单独安装。config 里插件段用到的插件也要列在这里
    "plugins": [
      { "id": "acme.talkfast-steps" },
      { "id": "acme.production" },
      { "id": "acme.publish-platforms" }
    ]
  },
  // 频道插件：住在本频道里的插件目录（相对频道根），随卡分享；收卡人打开频道时先过信任卡
  // "plugins": ["plugins/acme.talkfast-suite"],

  "runtime": {
    "endpoints": [
      { "id": "tts-endpoint", "capability": "channek.tts" }
      // 注意：只有 id + capability。URL / 模型路径写在这里会被校验直接拒——
      // 端点真值属于收卡人自己的插件设置。
    ]
  },

  "bundle": {
    "omit": [
      { "path": "brand/ip-actions",
        "reason": "IP 动作帧序列是作者形象专属，请用自己的 IP 生成一套" }
    ]
  }
}
